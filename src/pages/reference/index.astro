---
import WikiLayout from '../../layouts/WikiLayout.astro';
import AnalysisList from '../../components/AnalysisList.astro';
import WikiSidebar from '../../components/WikiSidebar.astro';
import { getAnalysisIndexData, getAnalysisPageItems, getTotalAnalysisPages } from '../../content/analysis';

const { allItems, categories, categoryCounts, sortedTags } = await getAnalysisIndexData();
const currentPage = 1;
const totalPages = getTotalAnalysisPages(allItems);
const pageItems = getAnalysisPageItems(allItems, currentPage);
---

<WikiLayout wide title="Reference | AUL DoX" description="AUL DoXのData（データ分析）の結果を読み解く分析記事のReference。統計の読み方、分かること、分かりきらないことを、元データのダッシュボードとあわせて確認できます。">
  <section class="wiki-home-header">
    <div>
      <p class="eyebrow">Analysis Index</p>
      <h1>AUL DoX Reference</h1>
      <p>Dataで公開している統計・ダッシュボードの分析結果を、読み方と注意点とあわせて解説する記事の一覧です。各記事から元データへ、各データからこの解説へ移動できます。</p>
    </div>
  </section>

  <section class="wiki-search" aria-label="記事検索">
    <div class="wiki-search-row">
      <div class="wiki-search-field">
        <label for="wiki-search-input">記事を検索</label>
        <input id="wiki-search-input" type="search" placeholder="記事タイトル、説明文で検索" autocomplete="off" />
      </div>
    </div>
  </section>

  <div class="wiki-shell">
    <WikiSidebar categories={categories} categoryCounts={categoryCounts} sortedTags={sortedTags} totalItems={allItems.length} />
    <AnalysisList items={pageItems} currentPage={currentPage} totalPages={totalPages} totalItems={allItems.length} />
  </div>

  <script is:inline>
    (() => {
      const input = document.querySelector('#wiki-search-input');
      const items = [...document.querySelectorAll('.note-item')];
      input?.addEventListener('input', () => {
        const query = input.value.trim().toLowerCase();
        for (const item of items) {
          item.hidden = !item.textContent.toLowerCase().includes(query);
        }
      });
    })();
  </script>
</WikiLayout>
