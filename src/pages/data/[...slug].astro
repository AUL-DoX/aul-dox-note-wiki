---
// 7Pipsが生成するスコープ付きフラグメント（<html>タグなし）をWikiLayout内に埋め込むルート。
// src/dashboards/<カテゴリ>/<ファイル>.html を /data/<カテゴリ>/<ファイル>/ として配信する。

import WikiLayout from '../../layouts/WikiLayout.astro';
import titleOverrides from '../../data-titles.json';
import { getCategoryLabel, getDataIndexUrl, getGroupSlug } from '../../data-categories';

const overrides = titleOverrides as Record<string, string>;

const htmlModules = import.meta.glob('../../dashboards/**/*.html', {
  query: '?raw',
  import: 'default',
  eager: true,
}) as Record<string, string>;

export function getStaticPaths() {
  const files = import.meta.glob('../../dashboards/**/*.html', {
    query: '?raw',
    import: 'default',
    eager: true,
  }) as Record<string, string>;

  return Object.keys(files).map((path) => {
    const slug = path.replace('../../dashboards/', '').replace(/\.html$/, '');
    return { params: { slug } };
  });
}

const { slug } = Astro.params;
const entry = Object.entries(htmlModules).find(
  ([path]) => path === `../../dashboards/${slug}.html`,
);
const dashboardHtml = entry?.[1] ?? '';
const h1 = dashboardHtml.match(/<h1>([\s\S]*?)<\/h1>/)?.[1].replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();
const pageTitle = overrides[`dashboards/${slug}`]?.trim() || h1 || slug;

// 一覧へ戻るリンク：/data の同じタブ・同じ分類を開いた状態で戻す。
const [category = '', ...rest] = (slug ?? '').split('/');
const categoryLabel = getCategoryLabel(category);
const backUrl = getDataIndexUrl(category, getGroupSlug(category, rest.join('/')));
---

<WikiLayout wide title={`${pageTitle} | データ分析 | AUL DoX Reference`} description={`${pageTitle}（${categoryLabel}）。AUL DoXのデータ分析ダッシュボード。`}>
  <nav class="data-back" aria-label="データ分析一覧へ戻る"><a href={backUrl}>← {categoryLabel}の一覧に戻る</a></nav>
  <Fragment set:html={dashboardHtml} />
  <nav class="data-back data-back-bottom" aria-label="データ分析一覧へ戻る"><a href={backUrl}>← {categoryLabel}の一覧に戻る</a></nav>
</WikiLayout>

<style>
  .data-back {
    margin: 0 0 16px;
    font-size: 0.92rem;
    font-weight: 700;
  }
  .data-back a {
    color: var(--accent);
  }
  .data-back-bottom {
    margin: 32px 0 0;
    padding-top: 16px;
    border-top: 1px solid var(--border);
  }
</style>
