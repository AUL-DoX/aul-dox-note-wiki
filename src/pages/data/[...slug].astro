---
// 7Pipsが生成するスコープ付きフラグメント（<html>タグなし）をWikiLayout内に埋め込むルート。
// src/dashboards/<カテゴリ>/<ファイル>.html を /data/<カテゴリ>/<ファイル>/ として配信する。

import WikiLayout from '../../layouts/WikiLayout.astro';
import titleOverrides from '../../data-titles.json';
import { getCategoryLabel, getDataIndexUrl, getGroupSlug } from '../../data-categories';
import { ensureH1, getDashboardDate, getDashboardSeo } from '../../dashboard-seo';
import { breadcrumb, webPageLd } from '../../seo';
import { getAnalysisForData, getAnalysisPath } from '../../content/analysis';

const overrides = titleOverrides as Record<string, string>;

const htmlModules = import.meta.glob('../../dashboards/**/*.html', {
  query: '?raw',
  import: 'default',
  eager: true,
}) as Record<string, string>;

export function getStaticPaths() {
  const files = import.meta.glob('../../dashboards/**/*.html', {
    query: '?raw',
    import: 'default',
    eager: true,
  }) as Record<string, string>;

  return Object.keys(files).map((path) => {
    const slug = path.replace('../../dashboards/', '').replace(/\.html$/, '');
    return { params: { slug } };
  });
}

const { slug } = Astro.params;
const entry = Object.entries(htmlModules).find(
  ([path]) => path === `../../dashboards/${slug}.html`,
);
const dashboardHtml = entry?.[1] ?? '';
// 表の名前：管理画面で付けたタイトル（data-titles.json）→ 本文の<h1>（「エグゼクティブサマリー」のような汎用名は除く）→ スラッグ。
const h1 = [...dashboardHtml.matchAll(/<h1[^>]*>([\s\S]*?)<\/h1>/g)]
  .map((m) => m[1].replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim())
  .find((text) => text && text !== 'エグゼクティブサマリー');
const baseTitle = overrides[`dashboards/${slug}`]?.trim() || h1 || slug;

// 一覧へ戻るリンク：/data の同じタブ・同じ分類を開いた状態で戻す。
const [category = '', ...rest] = (slug ?? '').split('/');
const categoryLabel = getCategoryLabel(category);
const seo = getDashboardSeo(dashboardHtml, baseTitle ?? '', categoryLabel);
const backUrl = getDataIndexUrl(category, getGroupSlug(category, rest.join('/')));
// このデータを解説しているReferenceの分析記事（記事側の dataSlugs から逆引き）。
const dashboardDate = getDashboardDate(dashboardHtml);
const pageTitle = `${seo.title} | AUL DoX データ分析`;
const jsonLd = [
  webPageLd({ title: pageTitle, description: seo.description, path: `/data/${slug}/`, modified: dashboardDate }),
  breadcrumb([
    { name: 'ホーム', path: '/' },
    { name: 'Data', path: '/data/' },
    { name: categoryLabel, path: `/data/${category}/` },
    { name: baseTitle ?? '', path: `/data/${slug}/` },
  ]),
];
const analysisEntries = await getAnalysisForData(slug ?? '');
---

<WikiLayout wide title={pageTitle} description={seo.description} jsonLd={jsonLd}>
  <nav class="data-back" aria-label="データ分析一覧へ戻る"><a href={backUrl}>← {categoryLabel}の一覧に戻る</a></nav>
  <Fragment set:html={ensureH1(dashboardHtml)} />
  {
    analysisEntries.length > 0 && (
      <aside class="data-link-box" aria-labelledby="analysis-link-heading">
        <h2 id="analysis-link-heading">このデータを読み解く記事（Reference）</h2>
        <ul>
          {analysisEntries.map((entry) => (
            <li><a href={getAnalysisPath(entry)}>{entry.data.title}</a></li>
          ))}
        </ul>
      </aside>
    )
  }
  <nav class="data-back data-back-bottom" aria-label="データ分析一覧へ戻る"><a href={backUrl}>← {categoryLabel}の一覧に戻る</a></nav>
</WikiLayout>

<style>
  .data-back {
    margin: 0 0 16px;
    font-size: 0.92rem;
    font-weight: 700;
  }
  .data-back a {
    color: var(--accent);
  }
  .data-back-bottom {
    margin: 32px 0 0;
    padding-top: 16px;
    border-top: 1px solid var(--border);
  }
</style>
