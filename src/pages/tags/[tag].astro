---
import WikiLayout from '../../layouts/WikiLayout.astro';
import AnalysisList from '../../components/AnalysisList.astro';
import WikiSidebar from '../../components/WikiSidebar.astro';
import { getAnalysisIndexData, getAnalysisPageItems, getTotalAnalysisPages } from '../../content/analysis';

export async function getStaticPaths() {
  const { sortedTags } = await getAnalysisIndexData();
  return sortedTags.map(([tag]) => ({ params: { tag }, props: { tag } }));
}

const { tag } = Astro.props;
const { allItems, categories, categoryCounts, sortedTags } = await getAnalysisIndexData();
const filteredItems = allItems.filter((entry) => entry.data.tags.includes(tag));
const currentPage = 1;
const totalPages = getTotalAnalysisPages(filteredItems);
const pageItems = getAnalysisPageItems(filteredItems, currentPage);
---

<WikiLayout wide noindex title={`#${tag} | AUL DoX Reference`} description={`#${tag} の分析記事一覧`}>
  <section class="wiki-home-header">
    <div>
      <p class="eyebrow">Tag</p>
      <h1>#{tag}</h1>
      <p>このタグの分析記事を新しい順に表示しています。</p>
    </div>
  </section>

  <div class="wiki-shell">
    <WikiSidebar categories={categories} categoryCounts={categoryCounts} sortedTags={sortedTags} totalItems={allItems.length} />
    <AnalysisList
      items={pageItems}
      currentPage={currentPage}
      totalPages={totalPages}
      totalItems={filteredItems.length}
      basePath={`/tags/${encodeURIComponent(tag)}/`}
    />
  </div>
</WikiLayout>
