---
import WikiLayout from '../layouts/WikiLayout.astro';
import { getLatestContent } from '../content/latestContent';

const areas = [
  { name: 'Reference', href: '/reference/', description: '記事・知識・開発記録を調べる' },
  { name: 'Data', href: '/data/', description: '医療・介護・障がい福祉などのデータ分析を見る' },
  { name: 'Suite', href: '/suite/', description: 'AUL DoXが開発したツールやプロトタイプを見る' },
];

const latestItems = await getLatestContent(9);
---
<WikiLayout wide home title="AUL DoX | 医療・介護・障がい福祉のデータ分析・AI・業務ツール" description="AUL DoXは、医療・介護・障がい福祉を中心に、データ分析やAI・業務ツールを設計・開発するAIアーキテクトです。Reference・Data・Suiteから知識、分析、開発実績をご覧いただけます。">
  <section class="home-directory" aria-labelledby="home-title">
    <p class="eyebrow">Analyze U Lab / Digital of eXperience</p>
    <h1 id="home-title">AUL DoX</h1>
    <div class="area-grid">
      {areas.map((area, i) => <a class="area-card" href={area.href}>
        <span class="area-number">0{i + 1}</span>
        <h2>{area.name}<span aria-hidden="true"> ↗</span></h2>
        <p>{area.description}</p>
      </a>)}
    </div>
  </section>

  <section class="latest-insights" aria-labelledby="latest-insights-title">
    <header class="latest-insights__header">
      <p class="eyebrow">Latest Insights</p>
      <h2 id="latest-insights-title">最新のデータ分析・記事</h2>
      <p>AUL DoXが公開しているデータ分析、調査レポート、知識・開発記録から、最近更新された内容をご紹介します。</p>
    </header>

    <div class="latest-grid">
      {latestItems.map((item) => (
        <article class="latest-card">
          <p class="latest-card__category">{item.typeLabel} / {item.category}</p>
          <h3><a href={item.href} target="_blank" rel="noopener noreferrer">{item.title}</a></h3>
          <p class="latest-card__description">{item.description}</p>
          <footer class="latest-card__footer">
            <time datetime={item.date.toISOString()}>{item.dateLabel}</time>
            <a href={item.href} target="_blank" rel="noopener noreferrer" aria-label={`${item.title}を読む`}>続きを読む <span aria-hidden="true">→</span></a>
          </footer>
        </article>
      ))}
    </div>

    <p class="latest-insights__more"><a href="/search/">すべての記事・データを探す <span aria-hidden="true">→</span></a></p>
  </section>
</WikiLayout>
