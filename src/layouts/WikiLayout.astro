---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import NoteLinkButton from '../components/NoteLinkButton.astro';
import Analytics from '@vercel/analytics/astro';
import '../styles/global.css';

const {
  title = 'AUL DoX Reference',
  description = '福祉DX、介護DX、就労継続支援、Obsidian活用、GASツール、AI制作メモを整理した公開wiki',
  noteUrl,
  wide = false,
  home = false,
} = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://aul-dox.jp');
// noteなどにリンクを貼った時のカード画像（1200x630。public/og-image.png）。
const ogImageUrl = new URL('/og-image.png', Astro.site ?? 'https://aul-dox.jp');
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content={home ? 'website' : 'article'} />
    <meta property="og:site_name" content="AUL DoX" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script
      is:inline
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-5257393735098403"
      crossorigin="anonymous"
    ></script>
  </head>
  <body>
    <Header home={home} />
    <main class:list={['main', wide && 'main--wide']}>
      <slot />
      {noteUrl && <div class="note-action"><NoteLinkButton href={noteUrl} /></div>}
    </main>
    <Footer />
    <Analytics />
  </body>
</html>
