---
import { formatDate } from '../content/wiki';
import { getAnalysisPath } from '../content/analysis';
import { getCategoryBySlug } from '../content/categories';

const { items, currentPage, totalPages, totalItems, basePath = '/' } = Astro.props;

function pageHref(page: number) {
  if (basePath === '/') {
    return page === 1 ? '/reference/' : `/page/${page}/`;
  }

  return page === 1 ? basePath : `${basePath}page/${page}/`;
}

let previousYear: number | null = null;
---

<section class="wiki-index" aria-label="分析記事一覧">
  <div class="wiki-index-heading">
    <div>
      <p class="eyebrow">Analysis</p>
      <h2>分析記事一覧</h2>
    </div>
    <p>{totalItems}件中 {items.length}件</p>
  </div>

  {items.length === 0 && <p>該当する記事はまだありません。</p>}

  <div class="note-list note-list--compact">
    {
      items.map((entry) => {
        const year = entry.data.date.getFullYear();
        const showYearHeading = year !== previousYear;
        previousYear = year;
        const category = getCategoryBySlug(entry.data.category);

        return (
          <>
            {showYearHeading && <h3 class="year-heading">{year}</h3>}
            <article class="note-item">
              <div class="note-item__meta">
                <span>{formatDate(entry.data.date)}</span>
                {category && <a href={`/categories/${category.slug}/`}>{category.title}</a>}
              </div>
              <h2>
                <a href={getAnalysisPath(entry)}>{entry.data.title}</a>
              </h2>
              <p>{entry.data.description}</p>
              <div class="note-item__actions">
                <a class="note-read-link" href={getAnalysisPath(entry)}>記事を読む</a>
                {entry.data.dataSlugs.length > 0 && (
                  <div class="linked-pages">
                    <span>元データ</span>
                    {entry.data.dataSlugs.map((slug) => (
                      <a href={`/data/${slug}/`}>{slug.split('/').pop()}</a>
                    ))}
                  </div>
                )}
              </div>
            </article>
          </>
        );
      })
    }
  </div>

  <nav class="pagination" aria-label="ページ送り">
    {Array.from({ length: totalPages }, (_, index) => index + 1).map((page) => (
      <a class:list={[page === currentPage && 'is-active']} href={pageHref(page)} aria-current={page === currentPage ? 'page' : undefined}>
        {page}
      </a>
    ))}
  </nav>
</section>
